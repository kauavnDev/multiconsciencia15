# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Free-tier AI providers. Add keys only on the server/Vercel; never use NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Paid providers are disabled unless you explicitly change this to true.
AI_ALLOW_PAID=false
# Only used when AI_ALLOW_PAID=true:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
